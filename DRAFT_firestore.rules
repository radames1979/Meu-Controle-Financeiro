rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Transaction Validation ---
    function isValidTransaction(data) {
      return data.keys().hasAll(['type', 'amount', 'description', 'date', 'category', 'account', 'status'])
        && data.keys().size() <= 15
        && data.type in ['income', 'expense']
        && data.amount is number
        && data.description is string && data.description.size() <= 500
        && data.date is string && data.date.size() <= 10
        && data.category is string && data.category.size() <= 100
        && data.account is string && data.account.size() <= 100
        && data.status in ['waiting', 'confirmed', 'paid'];
    }

    // --- User Settings Validation ---
    function isValidUserSettings(data) {
      return data.keys().size() <= 10;
    }

    // --- Routes ---
    match /artifacts/meu-controle-financeiro {
      match /users/{userId} {
        
        // Transações
        match /transactions/{transactionId} {
          allow get: if isOwner(userId) && isValidId(transactionId);
          allow list: if isOwner(userId) && (resource == null || resource.data.size() >= 0); // No blanket reads, userId is in path
          
          allow create: if isOwner(userId) 
            && isValidId(transactionId)
            && isValidTransaction(incoming());

          allow update: if isOwner(userId)
            && isValidId(transactionId)
            && isValidTransaction(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'type', 'amount', 'description', 'date', 'category', 'account', 'status',
              'paymentCodeType', 'paymentCode', 'recurringId', 'installmentNumber', 'totalInstallments'
            ]);

          allow delete: if isOwner(userId) && isValidId(transactionId);
        }

        // Configurações
        match /settings/userSettings {
          allow get, write: if isOwner(userId);
          allow write: if isOwner(userId) && isValidUserSettings(incoming());
        }
      }
    }
  }
}
