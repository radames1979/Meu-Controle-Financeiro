{
  "entities": {
    "Transaction": {
      "title": "Transaction",
      "description": "Financial income or expense record",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["income", "expense"] },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "category": { "type": "string" },
        "account": { "type": "string" },
        "status": { "type": "string", "enum": ["waiting", "confirmed", "paid"] },
        "paymentCodeType": { "type": "string" },
        "paymentCode": { "type": "string" },
        "recurringId": { "type": "string" },
        "installmentNumber": { "type": "number" },
        "totalInstallments": { "type": "number" }
      },
      "required": ["type", "amount", "description", "date", "category", "account", "status"]
    },
    "UserSettings": {
      "title": "User Settings",
      "description": "User specific configurations including budgets and custom categories",
      "type": "object",
      "properties": {
        "budgets": { "type": "object" },
        "categories": { "type": "object" },
        "layoutDensity": { "type": "string" },
        "theme": { "type": "string" }
      }
    }
  },
  "firestore": {
    "artifacts/meu-controle-financeiro/users/{userId}/transactions": {
      "schema": "Transaction",
      "description": "User financial transactions"
    },
    "artifacts/meu-controle-financeiro/users/{userId}/settings/userSettings": {
      "schema": "UserSettings",
      "description": "User application settings"
    }
  }
}
